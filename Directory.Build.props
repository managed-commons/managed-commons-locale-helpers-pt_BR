<Project>
    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <Version>2.0.2</Version>
        <Authors>Rafael Teixeira</Authors>
        <Company>Managed Commons Team</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Product>Managed Commons</Product>
        <Description>Holds a utility class to translate numbers to it's written form in Brazilian Portuguese</Description>
        <Copyright>Copyright (c) 2005-2026 Rafael 'Monoman' Teixeira, Managed Commons Team</Copyright>
        <Notes>
            - Eliminated dependency on Commons.Core (version 2.0.1)
            - Simplified project structure and build process
        </Notes>
    </PropertyGroup>
    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.Collections.Generic" />
        <Using Include="System.Linq" />
        <Using Include="System.Text" />
        <Using Include="System.Globalization" />
    </ItemGroup>
</Project>
